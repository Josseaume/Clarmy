{
  "name": "clarmy",
  "version": "0.1.0",
  "private": true,
  "description": "Clarmy — master cockpit for an army of clawds. One socket, N parallel Claude Code sessions, six states, zero friction.",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-transform-types server.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --experimental-transform-types server.ts",
    "start:orchestrator": "NODE_ENV=production node --experimental-transform-types server-orchestrator.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "next lint",
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "clarmy": "node bin/clarmy.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.10",
    "@lobehub/icons": "^5.10.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "next": "16.2.9",
    "node-pty": "^1.1.0",
    "phaser": "^4.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.13",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "bin": {
    "clarmy": "bin/clarmy.mjs"
  }
}
